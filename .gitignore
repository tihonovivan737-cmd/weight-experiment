# Исключения для репозитория с кодом эксперимента (без весов, окружения и датасета).
# Добавлено для публикации на GitHub; исходное дерево не меняется.

# окружение и данные
.venv/
models/
datasets/
nohup.out

# файлы моделей: копии внутри вариантов и любые веса
*.safetensors
**/model/

# собранные архивы аудита (они передаются отдельно, не через git)
runs/audit/
*.tar.gz

# временное окружение и отладочные артефакты Python
__pycache__/
*.pyc
.pytest_cache/

# служебное окружения DSH, если попадёт в каталог
.DS_Store
*.swp

# полные манифесты с пофайловыми массивами значений (до 1,2 ГиБ) не хранятся в git:
# их урезанные копии лежат в scripts/manifest_slim с блоком _upakovka
runs/variants/*/manifest.json
runs/discarded/**/manifest.json
